.device-list {
  border-top: 1px solid var(--border);
}
.device-row {
  box-sizing: border-box;
  width: 100%;
  padding: 28rpx 0;
  border-bottom: 1px solid var(--border);
}
.device-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.device-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 1.5;
  overflow-wrap: anywhere;
}
.device-meta {
  display: block;
  margin-top: 6rpx;
  color: var(--muted-foreground);
  font-size: 24rpx;
}
.device-meta.is-connected {
  color: var(--success);
}
.device-meta.is-pending {
  color: var(--info);
}
.device-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-left: 72rpx;
}
.connect-action {
  flex: 0 0 144rpx;
  width: 144rpx;
  min-height: 44px;
  padding: 18rpx 12rpx;
  font-size: 26rpx;
}
.rename-action {
  flex: 1;
  width: 0;
  text-align: left;
  margin-right: auto;
  min-height: 44px;
  padding: 18rpx 0;
  font-size: 26rpx;
}
.scan-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 24rpx;
  background: var(--muted);
  border-radius: 12rpx;
}
.scan-copy {
  flex: 1;
  min-width: 0;
}
.scan-hint {
  display: block;
  margin-top: 8rpx;
  color: var(--muted-foreground);
  font-size: 23rpx;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.scan-button {
  flex: 0 0 180rpx;
  width: 180rpx;
  min-height: 44px;
  padding: 18rpx 12rpx;
  font-size: 26rpx;
}
.discovered-list {
  margin-top: 24rpx;
}
.signal-copy {
  flex: 1;
  color: var(--muted-foreground);
  font-size: 23rpx;
}
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 28rpx;
  border-bottom: 1px solid var(--border);
  text-align: center;
}
.empty-desk {
  margin: 0 0 28rpx;
}
.empty-desk .desk-icon {
  width: 72rpx;
  height: 56rpx;
}
.empty-title {
  font-size: 30rpx;
  font-weight: 500;
}
.empty-copy {
  max-width: 480rpx;
  margin-top: 12rpx;
  color: var(--muted-foreground);
  font-size: 26rpx;
  line-height: 1.75;
}
.connection-footer {
  margin-top: 32rpx;
  color: var(--muted-foreground);
  font-size: 23rpx;
  line-height: 1.75;
  text-align: center;
}
.disconnect-button {
  width: 100%;
  margin-top: 24rpx;
  border-color: var(--border);
  color: var(--danger);
  font-size: 26rpx;
}
