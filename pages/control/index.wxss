.desk-connection {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 64rpx;
  margin-top: 8rpx;
}
.desk-picker-action {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 44px;
  color: var(--muted-foreground);
  font-size: 24rpx;
}
.height-stage {
  padding: 44rpx 0 40rpx;
  text-align: center;
}
.height-caption {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: var(--muted-foreground);
  font-size: 26rpx;
}
.height-caption .desk-icon {
  transform: scale(0.7);
  margin: -6rpx;
}
.height-reading {
  display: flex;
  justify-content: center;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 16rpx;
}
.height-value {
  font-size: 136rpx;
  font-weight: 500;
  letter-spacing: -0.04em;
  line-height: 1.15;
}
.height-unit {
  color: var(--muted-foreground);
  font-size: 32rpx;
}
.height-stage-offline .height-value {
  color: var(--muted-foreground);
}
.movement-status {
  margin-top: 20rpx;
  color: var(--muted-foreground);
  font-size: 26rpx;
}
.movement-status.is-pending {
  color: var(--info);
}
.speed-reading {
  display: block;
  margin-top: 8rpx;
  color: var(--muted-foreground);
  font-size: 24rpx;
}
.speed-reading-idle {
  visibility: hidden;
}
.connect-prompt {
  margin-bottom: 32rpx;
}
.connect-prompt button {
  width: 100%;
}
.preset-section {
  border-top: 1px solid var(--border);
  padding-top: 32rpx;
}
.preset-grid {
  display: flex;
  gap: 20rpx;
}
.preset-button {
  flex: 1 1 0;
  width: 0;
  padding: 24rpx;
  border-color: var(--input);
  background: var(--surface);
  text-align: left;
}
.preset-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.preset-direction {
  color: var(--muted-foreground);
  font-size: 30rpx;
}
.preset-value {
  display: block;
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 500;
}
.preset-moving {
  border-color: var(--info);
  background: var(--info-bg);
  color: var(--info);
}
.preset-moving .preset-direction {
  color: var(--info);
}
.manual-section {
  margin-top: 36rpx;
}
.manual-controls {
  display: flex;
  gap: 16rpx;
}
.manual-button,
.stop-button {
  flex: 1 1 0;
  width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 132rpx;
  padding: 16rpx;
  border-color: var(--input);
  background: var(--surface);
  font-size: 26rpx;
}
.control-arrow {
  font-size: 40rpx;
  line-height: 1;
}
.stop-symbol {
  width: 22rpx;
  height: 22rpx;
  margin: 9rpx 0;
  border-radius: 3rpx;
  background: currentColor;
}
.manual-active {
  background: var(--accent);
}
.stop-active {
  background: var(--primary);
  color: var(--primary-foreground);
  border-color: var(--primary);
}
.control-note {
  display: block;
  margin-top: 20rpx;
  color: var(--muted-foreground);
  font-size: 23rpx;
  line-height: 1.65;
  text-align: center;
}
.control-footer {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}
.control-footer button {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 24rpx;
}
@media (max-width: 350px) {
  .height-stage {
    padding: 28rpx 0;
  }
  .height-value {
    font-size: 120rpx;
  }
  .section-note {
    font-size: 23rpx;
  }
}
