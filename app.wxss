page {
  --background: #fbfbf9;
  --foreground: #22241f;
  --surface: #ffffff;
  --muted: #f5f5f2;
  --muted-foreground: #65695f;
  --accent: #ebede6;
  --primary: #22241f;
  --primary-foreground: #fbfbf9;
  --border: #dfe1d9;
  --input: #898e82;
  --info: #2458a6;
  --info-bg: #edf2fb;
  --success: #28704d;
  --danger: #b33236;
  --danger-bg: #fcecee;
  background: var(--background);
  color: var(--foreground);
  font-family:
    "Geist",
    -apple-system,
    BlinkMacSystemFont,
    "PingFang SC",
    "Noto Sans CJK SC",
    sans-serif;
  font-size: 28rpx;
  line-height: 1.55;
  font-kerning: normal;
}

@media (prefers-color-scheme: dark) {
  page {
    --background: #20221e;
    --foreground: #edeee8;
    --surface: #282b25;
    --muted: #191b18;
    --muted-foreground: #b2b7a9;
    --accent: #34382e;
    --primary: #e7ebdf;
    --primary-foreground: #22241f;
    --border: #3c4037;
    --input: #727a66;
    --info: #a5c2ff;
    --info-bg: #283346;
    --success: #9cd7b4;
    --danger: #ffadb0;
    --danger-bg: #44292d;
  }
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 40rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background: var(--background);
}

button {
  box-sizing: border-box;
  min-width: 0;
  width: auto;
  margin: 0;
  padding: 20rpx 24rpx;
  border: 1px solid transparent;
  border-radius: 12rpx;
  background: transparent;
  color: var(--foreground);
  font-family: inherit;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.55;
}

button::after {
  border: 0;
}
/* Override the native button disabled palette so labels stay readable. */
button[disabled]:not([type]) {
  background: var(--muted);
  color: var(--muted-foreground);
}
.button-primary {
  background: var(--primary);
  color: var(--primary-foreground);
}
.button-secondary {
  border-color: var(--input);
  background: var(--surface);
}
.button-ghost {
  color: var(--muted-foreground);
}
.button-pressed {
  opacity: 0.72;
}
button:focus-visible,
input:focus-visible {
  outline: 2px solid var(--info);
  outline-offset: 3px;
}

.page-header,
.section-heading,
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}
.header-copy,
.row-copy {
  flex: 1;
  min-width: 0;
}
.eyebrow {
  display: block;
  color: var(--muted-foreground);
  font-size: 22rpx;
  font-weight: 500;
  letter-spacing: 0.08em;
}
.page-title {
  display: block;
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.4;
  overflow-wrap: anywhere;
}
.page-description {
  display: block;
  margin-top: 16rpx;
  color: var(--muted-foreground);
  font-size: 28rpx;
  line-height: 1.75;
}
.header-action {
  flex: 0 0 64px;
  width: 64px;
  min-height: 44px;
  padding: 20rpx 0;
}
.section {
  margin-top: 48rpx;
}
.section-heading {
  align-items: baseline;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
}
.section-note {
  color: var(--muted-foreground);
  font-size: 24rpx;
  font-weight: 400;
}
.status {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: var(--muted-foreground);
  font-size: 24rpx;
}
.status-dot {
  flex: 0 0 10rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: currentColor;
}
.is-connected {
  color: var(--success);
}
.is-pending {
  color: var(--info);
}
.inline-error {
  display: block;
  margin-top: 16rpx;
  color: var(--danger);
  font-size: 26rpx;
  line-height: 1.65;
}
.numeric {
  font-variant-numeric: tabular-nums;
}
.chevron {
  width: 12rpx;
  height: 12rpx;
  border-top: 1.5px solid currentColor;
  border-right: 1.5px solid currentColor;
  transform: rotate(45deg);
}
.desk-icon {
  position: relative;
  display: block;
  flex: 0 0 48rpx;
  width: 48rpx;
  height: 42rpx;
  color: var(--muted-foreground);
}
.desk-icon::before {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  top: 7rpx;
  height: 5rpx;
  border-radius: 2rpx;
  background: currentColor;
}
.desk-icon::after {
  content: "";
  position: absolute;
  left: 6rpx;
  right: 6rpx;
  top: 12rpx;
  bottom: 0;
  border-left: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
}

@media (min-width: 600px) {
  .page {
    max-width: 600px;
    margin: 0 auto;
    padding-left: 32px;
    padding-right: 32px;
  }
}
